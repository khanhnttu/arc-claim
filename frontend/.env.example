# Public config only — never put private keys in a NEXT_PUBLIC_* variable.

# "mainnet" (chain 5042, explorer.arc.io) or "testnet" (chain 5042002, testnet.arcscan.app). Default: testnet.
NEXT_PUBLIC_ARC_NETWORK=

# Optional: override the RPC (default: rpc.mainnet.arc.io or rpc.testnet.arc.io for the selected network)
NEXT_PUBLIC_ARC_RPC_URL=

# Optional: WalletConnect Cloud project id (enables MetaMask mobile / QR wallets).
# Without it, browser-extension wallets still work.
NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID=

# Optional: public URL used in shareable claim links (default: current origin)
NEXT_PUBLIC_APP_URL=

# ---- Phase 2 (fill in after deploying; leave empty until then) ----
# With these empty, new payments keep using the Phase 1 contract, "Never expires" is disabled,
# and /airdrop only validates CSVs.
NEXT_PUBLIC_ARC_CLAIM_V2_ADDRESS=
NEXT_PUBLIC_ARC_CLAIM_V2_DEPLOY_BLOCK=
NEXT_PUBLIC_ARC_CLAIM_BATCH_ADDRESS=
NEXT_PUBLIC_ARC_CLAIM_BATCH_DEPLOY_BLOCK=

# Local test chains only (e.g. anvil with a mock token). Never set this for Arc Testnet.
NEXT_PUBLIC_USDC_ADDRESS=
